{
  "name": "world-champignons-storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env server/http.mjs",
    "build": "node scripts/build-hosted.mjs",
    "build:hosted": "node scripts/build-hosted.mjs",
    "test": "node --test tests/moonlit*.test.mjs",
    "catalog:reference": "node scripts/import-reference.mjs",
    "catalog:sync": "node --env-file-if-exists=.env scripts/sync-printful.mjs",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "php-parser": "^3.7.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5"
  }
}
